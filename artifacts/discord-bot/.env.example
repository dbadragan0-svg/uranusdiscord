# Discord application bot token.
DISCORD_TOKEN=

# Discord application/client ID.
DISCORD_CLIENT_ID=

# Optional: set this to register slash commands only in one server during development.
DISCORD_GUILD_ID=

# Set to true to deploy slash commands when the bot starts.
REGISTER_COMMANDS_ON_STARTUP=false

# Optional logging level reserved for future logging integrations.
LOG_LEVEL=info